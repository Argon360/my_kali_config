#!/usr/bin/env python3
"""
aerial - Apple TV Cinematic 4K Aerial Screensaver Player for Linux
Plays beautiful, seamless drone flyovers (Dubai, Greenland, Hawaii, London, NYC, SF, etc.)
using mpv. Exits instantly on any keypress or mouse click.
"""

import sys
import os
import random
import subprocess
import json
import urllib.request

ENTRIES_URL = "http://a1.phobos.apple.com/us/r1000/000/Features/atv/AutumnResources/videos/entries.json"
CACHE_DIR = os.path.expanduser("~/.cache/aerial")
CACHE_FILE = os.path.join(CACHE_DIR, "entries.json")
WALLPAPER_DIR = os.path.expanduser("~/.local/share/wallpapers/aerial")

def fetch_entries():
    os.makedirs(CACHE_DIR, exist_ok=True)
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass

    try:
        req = urllib.request.Request(ENTRIES_URL, headers={"User-Agent": "mpv/1.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode())
            with open(CACHE_FILE, "w", encoding="utf-8") as f:
                json.dump(data, f)
            return data
    except Exception as e:
        print(f"Error fetching aerial entries: {e}", file=sys.stderr)
        return []

def get_videos(data):
    videos = {}
    for collection in data:
        for asset in collection.get("assets", []):
            loc = asset.get("accessibilityLabel", "Aerial")
            url = asset.get("url")
            if loc and url:
                videos.setdefault(loc, []).append(url)
    return videos

def list_locations(videos):
    print("Available Apple TV Aerial Locations:\n")
    for loc, urls in sorted(videos.items()):
        print(f"  • {loc:<16} ({len(urls)} videos)")
    print("\nUsage:")
    print("  aerial               # Play a random cinematic aerial video")
    print("  aerial <location>    # e.g. aerial dubai, aerial greenland, aerial hawaii")
    print("  aerial download <loc># Download video locally for offline / KDE lock screen")

def play_video(url, title="Aerial Screensaver"):
    print(f"\n🎬 Launching Apple TV Aerial Screensaver: {title}")
    print("   [Press any key, Esc, or click to exit]\n")

    cmd = [
        "mpv",
        "--fullscreen",
        "--loop-file=inf",
        "--no-audio",
        "--cursor-autohide=always",
        "--cursor-autohide-fs-only",
        "--stop-screensaver=no",
        "--title=Apple TV Aerial Screensaver",
        "--geometry=100%x100%",
        "--input-default-bindings=yes",
        url
    ]

    try:
        subprocess.run(cmd)
    except KeyboardInterrupt:
        pass

def download_video(url, name):
    os.makedirs(WALLPAPER_DIR, exist_ok=True)
    filename = os.path.basename(url.split("?")[0])
    target = os.path.join(WALLPAPER_DIR, f"{name.lower().replace(' ', '_')}_{filename}")

    if os.path.exists(target):
        print(f"Video already downloaded: {target}")
        return target

    print(f"Downloading {name} Aerial video to {target}...")
    req = urllib.request.Request(url, headers={"User-Agent": "mpv/1.0"})
    with urllib.request.urlopen(req) as resp, open(target, "wb") as out:
        total = int(resp.headers.get("Content-Length", 0))
        downloaded = 0
        while True:
            chunk = resp.read(1024 * 1024)
            if not chunk:
                break
            out.write(chunk)
            downloaded += len(chunk)
            if total:
                percent = downloaded / total * 100
                print(f"\rProgress: {downloaded / 1024 / 1024:.1f} MB / {total / 1024 / 1024:.1f} MB ({percent:.1f}%)", end="", flush=True)
    print(f"\nSaved successfully to {target}")
    return target

def main():
    entries = fetch_entries()
    if not entries:
        print("No video entries found.", file=sys.stderr)
        sys.exit(1)

    videos = get_videos(entries)

    args = sys.argv[1:]
    if not args:
        loc = random.choice(list(videos.keys()))
        url = random.choice(videos[loc])
        play_video(url, title=f"{loc} (Apple TV 4K)")
        return

    subcmd = args[0].lower()
    if subcmd in ("list", "-l", "--list", "help", "-h", "--help"):
        list_locations(videos)
        return

    if subcmd == "download":
        target_loc = args[1].lower() if len(args) > 1 else random.choice(list(videos.keys())).lower()
        matched_loc = None
        for loc in videos:
            if target_loc in loc.lower():
                matched_loc = loc
                break
        if not matched_loc:
            print(f"Unknown location '{target_loc}'. Run 'aerial list' to see options.")
            sys.exit(1)
        url = random.choice(videos[matched_loc])
        download_video(url, matched_loc)
        return

    target_loc = subcmd
    matched_loc = None
    for loc in videos:
        if target_loc in loc.lower():
            matched_loc = loc
            break

    if not matched_loc:
        print(f"Unknown location '{target_loc}'. Run 'aerial list' to see options.")
        sys.exit(1)

    url = random.choice(videos[matched_loc])
    play_video(url, title=f"{matched_loc} (Apple TV 4K)")

if __name__ == "__main__":
    main()
