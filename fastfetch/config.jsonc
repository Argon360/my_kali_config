{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "cyan",
            "2": "blue"
        },
        "padding": {
            "top": 4,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan",
            "title": "cyan"
        },
        "bar": {
            "border": {
                "left": "\uee00",
                "leftElapsed": "\uee03",
                "right": "\uee02",
                "rightElapsed": "\uee05"
            },
            "char": {
                "total": "\uee01",
                "elapsed": "\uee04"
            },
            "color": {
                "total": null
            }
        },
        "percent": {
            "type": 3
        }
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#36} user    {#keys}│",
            "type": "title",
            "format": "{#36}{user-name-colored}{#39}@{host-name-colored}"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#34} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#36} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#35}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#33} desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#35}󱂬 wm      {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#32} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#31} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#34}󰏖 pkgs    {#keys}│",
            "type": "packages"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#35} host    {#keys}│",
            "type": "host"
        },
        {
            "key": "│ {#36} cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#33}󰢮 gpu     {#keys}│",
            "type": "gpu",
            "detectionMethod": "pci",
            "format": "{name} [{type}]"
        },
        {
            "key": "│ {#32}󰍹 display {#keys}│",
            "type": "display",
            "format": "{width}x{height} @ {refresh-rate}Hz ({inch}\")"
        },
        {
            "key": "│ {#34} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#31}󰓡 swap    {#keys}│",
            "type": "swap"
        },
        {
            "key": "│ {#35}󰋊 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#32} battery {#keys}│",
            "type": "battery"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
