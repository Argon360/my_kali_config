#!/usr/bin/env bash
# =============================================================================
#  apply-touchpad-drag-lock / gestures
#  Configures comprehensive trackpad gestures & behavior across KDE & GNOME:
#   - Tap-and-drag with Drag Lock (holds click when finger lifts to reposition)
#   - Modern Clickfinger (1 finger = Left, 2 fingers = Right, 3 fingers = Middle)
#   - Tap-to-click & palm rejection (Disable While Typing)
#   - 1:1 Multitouch Wayland Gestures (3-finger & 4-finger swipe/pinch)
#   - Multiple Virtual Desktops (4 workspaces) with wrap-around navigation
#   - Screen Edge / Hot Corner gestures (Overview, Grid, Show Desktop)
# =============================================================================

set -e

# 1. KDE Plasma (Wayland / KWin)
if command -v qdbus6 &>/dev/null && qdbus6 org.kde.KWin &>/dev/null; then
    # Virtual Desktops: If Kyanite dynamic workspaces is not active, ensure at least 4 desktops
    is_kyanite=$(kreadconfig6 --file kwinrc --group "Plugins" --key "kyaniteEnabled" 2>/dev/null || echo "false")
    if [ "$is_kyanite" != "true" ]; then
        vd_count=$(qdbus6 org.kde.KWin /VirtualDesktopManager org.kde.KWin.VirtualDesktopManager.count 2>/dev/null || echo "1")
        if [ "$vd_count" -lt 4 ]; then
            for i in $(seq $((vd_count + 1)) 4); do
                qdbus6 org.kde.KWin /VirtualDesktopManager org.kde.KWin.VirtualDesktopManager.createDesktop "$((i - 1))" "Desktop $i" 2>/dev/null || true
            done
        fi
    fi

    # Enable workspace wrap-around navigation
    if command -v gdbus &>/dev/null; then
        gdbus call --session -d org.kde.KWin -o /VirtualDesktopManager -m org.freedesktop.DBus.Properties.Set org.kde.KWin.VirtualDesktopManager navigationWrappingAround "<true>" 2>/dev/null || true
    fi

    # Configure Screen Edge / Hot Corners for trackpad cursor gestures
    if command -v kwriteconfig6 &>/dev/null; then
        kwriteconfig6 --file kwinrc --group "ElectricBorders" --key "TopLeft" "Overview"
        kwriteconfig6 --file kwinrc --group "ElectricBorders" --key "TopRight" "Grid"
        kwriteconfig6 --file kwinrc --group "ElectricBorders" --key "BottomRight" "ShowDesktop"
        qdbus6 org.kde.KWin /KWin reconfigure 2>/dev/null || true
    fi

    # Configure Touchpads
    for dev in $(qdbus6 org.kde.KWin 2>/dev/null | grep -E '^/org/kde/KWin/InputDevice/event'); do
        is_tp=$(qdbus6 org.kde.KWin "$dev" org.freedesktop.DBus.Properties.Get org.kde.KWin.InputDevice touchpad 2>/dev/null || true)
        if [ "$is_tp" = "true" ]; then
            # Enable live via DBus
            if command -v gdbus &>/dev/null; then
                gdbus call --session -d org.kde.KWin -o "$dev" -m org.freedesktop.DBus.Properties.Set org.kde.KWin.InputDevice tapDragLock "<true>" 2>/dev/null || true
                gdbus call --session -d org.kde.KWin -o "$dev" -m org.freedesktop.DBus.Properties.Set org.kde.KWin.InputDevice tapAndDrag "<true>" 2>/dev/null || true
                gdbus call --session -d org.kde.KWin -o "$dev" -m org.freedesktop.DBus.Properties.Set org.kde.KWin.InputDevice tapToClick "<true>" 2>/dev/null || true
                gdbus call --session -d org.kde.KWin -o "$dev" -m org.freedesktop.DBus.Properties.Set org.kde.KWin.InputDevice clickMethodClickfinger "<true>" 2>/dev/null || true
                gdbus call --session -d org.kde.KWin -o "$dev" -m org.freedesktop.DBus.Properties.Set org.kde.KWin.InputDevice disableWhileTyping "<true>" 2>/dev/null || true
            fi

            # Read hardware vendor/product/name for kcminputrc persistence
            vendor=$(qdbus6 org.kde.KWin "$dev" org.freedesktop.DBus.Properties.Get org.kde.KWin.InputDevice vendor 2>/dev/null || true)
            product=$(qdbus6 org.kde.KWin "$dev" org.freedesktop.DBus.Properties.Get org.kde.KWin.InputDevice product 2>/dev/null || true)
            name=$(qdbus6 org.kde.KWin "$dev" org.freedesktop.DBus.Properties.Get org.kde.KWin.InputDevice name 2>/dev/null || true)

            if [ -n "$vendor" ] && [ -n "$product" ] && [ -n "$name" ] && command -v kwriteconfig6 &>/dev/null; then
                kwriteconfig6 --file kcminputrc --group "Libinput" --group "$vendor" --group "$product" --group "$name" --key "TapDragLock" "true"
                kwriteconfig6 --file kcminputrc --group "Libinput" --group "$vendor" --group "$product" --group "$name" --key "TapAndDrag" "true"
                kwriteconfig6 --file kcminputrc --group "Libinput" --group "$vendor" --group "$product" --group "$name" --key "TapToClick" "true"
                kwriteconfig6 --file kcminputrc --group "Libinput" --group "$vendor" --group "$product" --group "$name" --key "ClickMethod" "2"
                kwriteconfig6 --file kcminputrc --group "Libinput" --group "$vendor" --group "$product" --group "$name" --key "DisableWhileTyping" "true"
            fi
        fi
    done
fi

# 2. GNOME / GSettings
if command -v gsettings &>/dev/null; then
    schema="org.gnome.desktop.peripherals.touchpad"
    if gsettings list-schemas 2>/dev/null | grep -q "^$schema$"; then
        for key in tap-and-drag-lock tap-and-drag tap-to-click disable-while-typing two-finger-scrolling-enabled; do
            if gsettings list-keys "$schema" 2>/dev/null | grep -q "^$key$"; then
                gsettings set "$schema" "$key" true 2>/dev/null || true
            fi
        done
        if gsettings list-keys "$schema" 2>/dev/null | grep -q "^click-method$"; then
            gsettings set "$schema" click-method 'fingers' 2>/dev/null || true
        fi
    fi

    # Dynamic Workspaces
    if gsettings list-schemas 2>/dev/null | grep -q "^org.gnome.mutter$"; then
        gsettings set org.gnome.mutter dynamic-workspaces true 2>/dev/null || true
    fi
fi
